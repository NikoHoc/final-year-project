{
  "expo": {
    "name": "Depot Bakso Asli Balikpapan",
    "slug": "frontend-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/images/logo_sapi.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/logo_sapi.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo_sapi.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEF9C3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/logo_sapi.png",
        "resizeMode": "contain",
        "backgroundColor": "#FEF9C3"
      }
    },
    "android": {

      "splash": {
        "image": "./assets/images/logo_sapi.png",
        "resizeMode": "contain",
        "backgroundColor": "#FEF9C3"
      }
    }
  }
}
